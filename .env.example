# TrophyVault development environment.
# Copy to .env (scripts/setup.sh does this and generates the secrets). NEVER commit .env.
# This is a development configuration, not a production deployment.

# --- Host ---------------------------------------------------------------------
# The only port published on the host (bound to 127.0.0.1). 8080 is taken by SABnzbd on the
# maintainer's machine; check yours with: ss -tln | grep :<port>
APP_PORT=8190
HOST_UID=1000
HOST_GID=1000

# --- Laravel ------------------------------------------------------------------
APP_NAME=TrophyVault
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8190
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- PostgreSQL (development database; tests use "<DB_DATABASE>_test") ----------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=trophyvault
DB_USERNAME=trophyvault
DB_PASSWORD=

# --- Redis ---------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Cache / queue / session ---------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Future secrets -------------------------------------------------------------
# PSN credentials / tokens will live in .env or in git-ignored secrets/ files only.
